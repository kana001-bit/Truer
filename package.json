{
  "name": "@kana001-bit/truer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "tru": "dist/cli/tru.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "npm run typecheck && npm run build",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "tru": "node ./src/cli/tru.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "description": "Proposes minimal geometry corrections for sewing patterns from Seamlint diagnostics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kana001-bit/truer.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
